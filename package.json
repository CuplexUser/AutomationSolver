{
  "name": "automationsolver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client",
    "site"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @automationsolver/server\" \"npm run dev -w @automationsolver/client\"",
    "build": "npm run build -w @automationsolver/client",
    "build:pages": "npm run build -w @automationsolver/site && node scripts/build-pages.mjs",
    "test": "npm run test -w @automationsolver/shared && npm run test -w @automationsolver/server && npm run test -w @automationsolver/client",
    "test:shared": "npm run test -w @automationsolver/shared",
    "test:client": "npm run test -w @automationsolver/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
